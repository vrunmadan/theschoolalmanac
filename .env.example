# Copy to .env.local and fill in. The app runs WITHOUT these (directory works,
# reviews show "Building") so you can deploy the directory first and add reviews later.

# Supabase (Stage 2 — reviews & scores). Both required together with
# PARENT_HASH_SALT below — reviewsConfigured() gates on all three.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Required once Supabase is configured — no public fallback (see
# app/api/reviews/route.js). Generate with e.g. `openssl rand -hex 32`.
# Reviewer identity is sha256(this salt + '|' + identity); without a real secret
# here, review author hashes would be guessable across every deployment.
PARENT_HASH_SALT=

# Gates GET /api/admin/submissions and POST /api/admin/reviews/:id/verify — never
# open by default (both 503 until this is set). Generate with `openssl rand -hex 24`
# and keep it out of chat/shared docs — it was leaked in plaintext once already.
ADMIN_KEY=

# Notion (optional Stage 1 CMS; the app falls back to data/schools.json if unset).
# scripts/sync-notion.mjs reads NOTION_DB_ID first, then this, then a hardcoded
# default — set ONE of these two explicitly in Netlify so the build never silently
# falls back to a default that might not be the database enrichment writes to.
NOTION_TOKEN=
NOTION_DB_ID=627ff4b5-c1f7-46db-918a-f1216941638e
NOTION_DATA_SOURCE_ID=627ff4b5-c1f7-46db-918a-f1216941638e

# Optional: product analytics (app/components/Analytics.js). Inert if unset — no
# account was created on your behalf. Create a free GA4 property at
# analytics.google.com, then set the Measurement ID (starts with "G-") here.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Optional: outbound mail (lib/mailer.js) — currently used for the claim
# email-confirmation link. Inert if unset (the confirmation link is returned
# directly in the API response instead, and shown in the claim UI). Set
# MAIL_PROVIDER=resend + RESEND_API_KEY to actually send; add another provider
# in lib/mailer.js (e.g. Workspace SMTP relay) if you'd rather not use Resend.
MAIL_PROVIDER=
RESEND_API_KEY=
MAIL_FROM=The School Almanac <hello@theschoolalmanac.com>
